{
  "name": "post-map",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "licence": "pnpm run notice && pnpm run reuse",
    "licence:check": "pnpm run notice:check && pnpm run reuse:check",
    "notice": "node --experimental-strip-types scripts/gen-notice.mjs",
    "notice:check": "node --experimental-strip-types scripts/gen-notice.mjs --check",
    "reuse": "node --experimental-strip-types scripts/gen-reuse.mjs",
    "reuse:check": "node --experimental-strip-types scripts/gen-reuse.mjs --check",
    "fetch:redirects": "node --experimental-strip-types scripts/fetch-redirect-targets.ts",
    "images": "node scripts/gen-map-images.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "linkedom": "^0.18.13",
    "next": "^16.2.12",
    "ol": "^10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "postcss@<8.5.18": "^8.5.23",
      "sharp@<0.35.0": "^0.35.0"
    }
  }
}
