{
  "name": "post-map",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "licence": "pnpm run notice && pnpm run reuse",
    "licence:check": "pnpm run notice:check && pnpm run reuse:check",
    "notice": "node --experimental-strip-types scripts/gen-notice.mjs",
    "notice:check": "node --experimental-strip-types scripts/gen-notice.mjs --check",
    "reuse": "node --experimental-strip-types scripts/gen-reuse.mjs",
    "reuse:check": "node --experimental-strip-types scripts/gen-reuse.mjs --check",
    "fetch:redirects": "node --experimental-strip-types scripts/fetch-redirect-targets.ts",
    "images": "node scripts/gen-map-images.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "linkedom": "^0.18.14",
    "next": "^16.4.3",
    "ol": "^10.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
